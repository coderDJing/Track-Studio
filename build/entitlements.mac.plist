<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron 的 V8 需要 JIT，否则渲染进程会直接崩溃 -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!--
      demucs / 音轨分离的 Python 运行时依赖 DYLD_LIBRARY_PATH 找到自带的 so，
      硬化运行时会清掉子进程的 DYLD_* 变量，缺少这一项会导致运行时起不来。
    -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!--
      应用会 dlopen Contents/Resources/r3-stretch 下的 librubberband.3.dylib，
      以及 app.asar.unpacked 里的 .node 原生模块。开启库校验前必须放行，
      否则本地未签名构建会因为校验失败而无法启动。
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
