@@ -0,0 +1,72 @@
+import { onBeforeUnmount, ref, watch, type CSSProperties, type Ref } from 'vue'
+import { positionPopover } from '../utils/overlayLayout'
+
+/** Body-teleported panels follow their anchor even while a dialog is dragged. */
+export function useAnchoredPopover(
+  open: Ref<boolean>,
+  anchor: Ref<HTMLElement | null>,
+  panel: Ref<HTMLElement | null>,
+  options: {
+    width?: number
+    maxHeight: () => number
+    center?: boolean
+    contentHeight?: () => number
+  }
+) {
+  const style = ref<CSSProperties>({ visibility: 'hidden' })
+  let frame = 0
+  let previous = ''
+  const update = () => {
+    if (!open.value) return
+    const trigger = anchor.value
+    const element = panel.value
+    if (trigger && element) {
+      const dialog = trigger.closest('.dialog')
+      if (!trigger.isConnected || (dialog && !dialog.classList.contains('dialog-visible'))) {
+        open.value = false
+        return
+      }
+      const rect = trigger.getBoundingClientRect()
+      const scrollViewport = trigger.closest('[data-overlayscrollbars-viewport]')
+      const clip = scrollViewport?.getBoundingClientRect()
+      if (clip && (rect.bottom <= clip.top || rect.top >= clip.bottom)) {
+        open.value = false
+        return
+      }
+      const { left, top, width, maxHeight } = positionPopover({
+        anchor: rect,
+        width: options.width ?? rect.width,
+        contentHeight: options.contentHeight?.() ?? element.scrollHeight + 2,
+        maxHeight: options.maxHeight(),
+        center: options.center,
+        viewportWidth: window.innerWidth,
+        viewportHeight: window.innerHeight
+      })
+      const next = `${left},${top},${width},${maxHeight}`
+      if (next !== previous) {
+        previous = next
+        style.value = {
+          position: 'fixed',
+          left: `${left}px`,
+          top: `${top}px`,
+          width: `${width}px`,
+          maxHeight: `${maxHeight}px`,
+          visibility: 'visible'
+        }
+      }
+    }
+    frame = requestAnimationFrame(update)
+  }
+  watch(
+    open,
+    (visible) => {
+      cancelAnimationFrame(frame)
+      previous = ''
+      style.value = { visibility: 'hidden' }
+      if (visible) frame = requestAnimationFrame(update)
+    },
+    { flush: 'post' }
+  )
+  onBeforeUnmount(() => cancelAnimationFrame(frame))
+  return style
+}
diff --git a/src/renderer/src/utils/overlayLayout.ts b/src/renderer/src/utils/overlayLayout.ts
new file mode 100644
index 00000000..67f082bc
--- /dev/null
+++ b/src/renderer/src/utils/overlayLayout.ts
@@ -0,0 +1,50 @@
+// Shared with .dialog padding in main.scss: 35px title bar + 8px edge gap.
+export const OVERLAY_TOP = 43
+export const OVERLAY_GAP = 8
+
+export function constrainDialog(
+  left: number,
+  top: number,
+  width: number,
+  height: number,
+  viewportWidth: number,
+  viewportHeight: number
+) {
+  return {
+    left: Math.max(OVERLAY_GAP, Math.min(left, viewportWidth - OVERLAY_GAP - width)),
+    top: Math.max(OVERLAY_TOP, Math.min(top, viewportHeight - OVERLAY_GAP - height))
+  }
+}
+
+export function positionPopover(input: {
+  anchor: { left: number; top: number; bottom: number; width: number }
+  width: number
+  contentHeight: number
+  maxHeight: number
+  viewportWidth: number
+  viewportHeight: number
+  center?: boolean
+}) {
+  const { anchor, viewportWidth, viewportHeight } = input
+  const width = Math.max(0, Math.min(input.width, viewportWidth - 2 * OVERLAY_GAP))
+  const below = Math.max(0, viewportHeight - OVERLAY_GAP - anchor.bottom - 4)
+  const above = Math.max(0, anchor.top - OVERLAY_TOP - 4)
+  const desired = Math.min(input.contentHeight, input.maxHeight)
+  const upwards = below < desired && above > below
+  const maxHeight = Math.max(0, Math.min(input.maxHeight, upwards ? above : below))
+  return {
+    left: Math.max(
+      OVERLAY_GAP,
+      Math.min(
+        input.center ? anchor.left + (anchor.width - width) / 2 : anchor.left,
+        viewportWidth - width - OVERLAY_GAP
+      )
+    ),
+    top: Math.max(
+      OVERLAY_TOP,
+      upwards ? anchor.top - 4 - Math.min(input.contentHeight, maxHeight) : anchor.bottom + 4
+    ),
+    width,
+    maxHeight
+  }
+}
