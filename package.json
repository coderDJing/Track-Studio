{
  "name": "frkb",
  "version": "1.2.4-rc.202609081730",
  "description": "Track Studio — Rapid Audio Organization Tool",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "./out/main/index.js",
  "author": "CoderDJing",
  "homepage": "https://github.com/coderDJing/Track-Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/coderDJing/Track-Studio.git"
  },
  "build": {
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "vendor/rekordbox-desktop-runtime",
        "to": "rekordboxDesktopRuntime"
      },
      {
        "from": "resources/rekordboxDesktopLibrary",
        "to": "rekordboxDesktopLibrary"
      },
      {
        "from": "scripts/beat_this_bridge.py",
        "to": "demucs/bootstrap/beat_this_bridge.py"
      },
      {
        "from": "scripts/beat_this_grid_solver.py",
        "to": "demucs/bootstrap/beat_this_grid_solver.py"
      },
      {
        "from": "scripts/beat_this_candidate_solver.py",
        "to": "demucs/bootstrap/beat_this_candidate_solver.py"
      },
      {
        "from": "scripts/beat_this_grid_rescue.py",
        "to": "demucs/bootstrap/beat_this_grid_rescue.py"
      },
      {
        "from": "scripts/beat_this_full_logit_rescue.py",
        "to": "demucs/bootstrap/beat_this_full_logit_rescue.py"
      },
      {
        "from": "scripts/beat_this_full_logit_utils.py",
        "to": "demucs/bootstrap/beat_this_full_logit_utils.py"
      },
      {
        "from": "scripts/beat_this_phase_rescue.py",
        "to": "demucs/bootstrap/beat_this_phase_rescue.py"
      },
      {
        "from": "scripts/beat_this_phase_arbitration.py",
        "to": "demucs/bootstrap/beat_this_phase_arbitration.py"
      },
      {
        "from": "scripts/beat_this_bpm_metrics.py",
        "to": "demucs/bootstrap/beat_this_bpm_metrics.py"
      },
      {
        "from": "scripts/beat_this_window_selection.py",
        "to": "demucs/bootstrap/beat_this_window_selection.py"
      },
      {
        "from": "scripts",
        "to": "demucs/bootstrap",
        "filter": [
          "beat_this_anchor_tuning_defaults.py",
          "beat_this_runtime_constant_grid.py",
          "rkb_beatgrid_candidate_lab.py",
          "rkb_constant_grid_dp_cache.py",
          "rkb_constant_grid_dp_cli.py",
          "rkb_constant_grid_dp_high_structural.py",
          "rkb_constant_grid_dp_octave.py",
          "rkb_constant_grid_dp_phase_path.py",
          "rkb_constant_grid_dp_selection.py",
          "rkb_constant_grid_dp_solver.py",
          "rkb_official_downbeat_selector.py",
          "rkb_official_phase_selector.py",
          "rkb_locked_phase_ranker.py",
          "rkb_locked_phase_ranker_features.py",
          "rkb_runtime_candidate_utils.py",
          "rkb_runtime_grid_common.py",
          "models/rkb-official-downbeat-rotation-candidate-v1.json"
        ]
      }
    ],
    "appId": "com.electron.frkb",
    "productName": "Track Studio",
    "afterSign": "build/afterSign.cjs",
    "artifactName": "Track-Studio-${version}-${os}-${arch}.${ext}",
    "files": [
      "**/*",
      "!vendor{,/**/*}",
      "!drafts{,/**/*}",
      "!tmp{,/**/*}",
      "!.codex_tmp{,/**/*}",
      "!test-data{,/**/*}",
      "!grid-analysis-lab{,/**/*}",
      "!structure-analysis-lab{,/**/*}",
      "!rust_package/native/ffmpeg/darwin{,/**/*}",
      "!rust_package/native/ffmpeg/darwin-arm64{,/**/*}",
      "!rust_package/native/ffmpeg/darwin-x64{,/**/*}",
      "!rust_package/target{,/**/*}",
      "!node_modules/rust_package/target{,/**/*}"
    ],
    "asarUnpack": [
      "resources/**"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "wav",
          "flac",
          "aif",
          "aiff",
          "ogg",
          "opus",
          "aac",
          "m4a",
          "mp4",
          "wma",
          "ac3",
          "dts",
          "mka",
          "webm",
          "ape",
          "tak",
          "tta",
          "wv"
        ],
        "name": "Track Studio Audio",
        "description": "Audio files supported by Track Studio",
        "role": "Editor"
      }
    ],
    "win": {
      "artifactName": "Track-Studio-Setup-${version}.${ext}",
      "executableName": "FRKB",
      "extraResources": [
        {
          "from": "vendor/demucs/models",
          "to": "demucs/models"
        },
        {
          "from": "vendor/demucs/bootstrap",
          "to": "demucs/bootstrap"
        },
        {
          "from": "vendor/r3-stretch/win32-x64",
          "to": "r3-stretch/win32-x64"
        }
      ]
    },
    "nsis": {
      "uninstallDisplayName": "Track Studio",
      "shortcutName": "Track Studio",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true
    },
    "mac": {
      "executableName": "FRKB",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "vendor/demucs/models",
          "to": "demucs/models"
        },
        {
          "from": "vendor/demucs/bootstrap",
          "to": "demucs/bootstrap"
        },
        {
          "from": "vendor/r3-stretch/darwin-universal",
          "to": "r3-stretch/darwin-universal"
        }
      ],
      "x64ArchFiles": "{Contents/Frameworks/**/*,Contents/Resources/ffmpeg/darwin/{ffmpeg,ffprobe},Contents/Resources/rekordboxDesktopRuntime/**/*,Contents/Resources/app.asar.unpacked/node_modules/@parcel/watcher-darwin-arm64/**/*,Contents/Resources/app.asar.unpacked/node_modules/better-sqlite3/**/*,Contents/Resources/app.asar.unpacked/node_modules/better-sqlite3-multiple-ciphers/**/*,Contents/Resources/app.asar.unpacked/node_modules/rust_package/**/*}",
      "artifactName": "Track-Studio-${version}-universal.${ext}"
    },
    "linux": {
      "extraResources": [
        {
          "from": "vendor/demucs/models",
          "to": "demucs/models"
        },
        {
          "from": "vendor/demucs/bootstrap",
          "to": "demucs/bootstrap"
        },
        {
          "from": "vendor/demucs/linux-x64",
          "to": "demucs/linux-x64",
          "filter": [
            "runtime*/**"
          ]
        },
        {
          "from": "vendor/demucs/linux-arm64",
          "to": "demucs/linux-arm64",
          "filter": [
            "runtime*/**"
          ]
        }
      ]
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "benchmark:song-structure": "tsx scripts/benchmark_song_structure_truth.ts",
    "inspect:song-structure": "tsx scripts/inspect_song_structure.ts",
    "song-structure:truth:add": "tsx scripts/add_song_structure_truth_sample.ts",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "test:key-analysis": "vitest run src/main/libraryCacheDb/songCacheAnalysisFields.spec.ts src/main/services/keyAnalysis/analysisTargets.spec.ts src/main/services/keyAnalysis/jobOwnership.spec.ts src/main/services/keyAnalysis/queueActiveFollowUp.spec.ts src/main/services/keyAnalysis/structurePersistence.spec.ts src/main/services/keyAnalysis/workerDispatch.spec.ts src/main/services/songStructureCachePolicy.spec.ts src/main/services/sharedSongGridCachePolicy.spec.ts src/main/services/sharedSongGrid.spec.ts src/renderer/src/composables/horizontalBrowse/useHorizontalBrowseDeckSongSync.spec.ts src/renderer/src/utils/manualKeyAnalysis.spec.ts src/shared/analysisBpmRange.spec.ts src/shared/trackReanalysisSelection.spec.ts",
    "grid:check-active-v2": "node scripts/check-active-grid-v2.mjs",
    "test:song-structure": "vitest run src/main/workers/songAnalysisAudioDecoder.spec.ts src/shared/songAnalysisCompleteness.spec.ts src/shared/songStructureDirectionalBoundaries.spec.ts src/shared/songStructureFeatureData.spec.ts src/shared/songStructureSemanticBoundaryAlignment.spec.ts src/shared/songStructureSemanticFoundationLanding.spec.ts src/shared/songStructureSemanticMacroActivity.spec.ts src/shared/songStructureSemanticOutro.spec.ts src/shared/songStructureSemanticRefinement.spec.ts src/shared/songStructureSemanticStability.spec.ts src/shared/songStructureSemanticStateGuards.spec.ts src/shared/songStructureSpectral.spec.ts src/shared/songStructureStale.spec.ts src/shared/songStructureStructuralEvidence.spec.ts src/shared/songStructureTimeBasis.spec.ts src/shared/songStructureV23.spec.ts",
    "start": "electron-vite preview",
    "dev": "node scripts/run-frkb-dev.mjs",
    "dev:no-runtime": "node scripts/run-frkb-dev.mjs --no-runtime",
    "dev:release-runtime": "node scripts/run-frkb-dev.mjs --release-runtime",
    "build": "node scripts/ensure-rust-package-native.mjs --mode package && electron-vite build",
    "rust-package:ensure": "node scripts/ensure-rust-package-native.mjs --mode dev",
    "rust-package:ensure:package": "node scripts/ensure-rust-package-native.mjs --mode package",
    "master-tempo:benchmark": "node scripts/ensure-rust-package-native.mjs --mode dev && node scripts/master-tempo-ab-benchmark.mjs",
    "media-tools:ensure": "node scripts/ensure-bundled-media-tools.mjs --mode dev",
    "media-tools:ensure:package": "node scripts/ensure-bundled-media-tools.mjs --mode package",
    "media-tools:ensure:win": "node scripts/ensure-bundled-media-tools.mjs --mode package --platform-key win32-x64",
    "media-tools:validate": "node scripts/validate-bundled-media-tools.mjs --mode dev",
    "media-tools:validate:package": "node scripts/validate-bundled-media-tools.mjs --mode package",
    "media-tools:validate:win": "node scripts/validate-bundled-media-tools.mjs --mode package --platform-key win32-x64",
    "media-tools:validate:mac-universal": "node scripts/validate-bundled-media-tools.mjs --mode package --platform-key darwin-universal",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist",
    "build:unpack": "npm run media-tools:ensure:package && npm run build && npm run rekordbox:runtime:ensure && npm run rekordbox:runtime:validate && electron-builder --dir",
    "build:win": "npm run clean && npm run media-tools:ensure:win && npm run build && npm run rekordbox:runtime:ensure && npm run rekordbox:runtime:validate && electron-builder --win",
    "build:mac": "npm run clean && npm run media-tools:validate:mac-universal && npm run build && npm run rekordbox:runtime:ensure:mac-universal && npm run rekordbox:runtime:validate:mac-universal && electron-builder --mac",
    "build:linux": "npm run clean && npm run build && electron-builder --linux",
    "demucs:runtime:prepare": "node scripts/prepare-demucs-runtimes.mjs",
    "demucs:runtime:ensure": "node scripts/ensure-demucs-runtime.mjs",
    "demucs:runtime:ensure:win": "node scripts/ensure-demucs-runtime.mjs --platform win32-x64",
    "demucs:runtime:ensure:mac-arm64": "node scripts/ensure-demucs-runtime.mjs --platform darwin-arm64",
    "demucs:runtime:ensure:mac-x64": "node scripts/ensure-demucs-runtime.mjs --platform darwin-x64",
    "rekordbox:runtime:ensure": "node scripts/ensure-rekordbox-desktop-runtime.mjs",
    "rekordbox:runtime:ensure:mac-universal": "node scripts/ensure-rekordbox-desktop-runtime.mjs --platform-key darwin-arm64 && node scripts/ensure-rekordbox-desktop-runtime.mjs --platform-key darwin-x64",
    "rekordbox:runtime:validate": "node scripts/validate-rekordbox-desktop-runtime.mjs",
    "rekordbox:runtime:validate:mac-universal": "node scripts/validate-rekordbox-desktop-runtime.mjs --platform-key darwin-arm64 --platform-key darwin-x64",
    "demucs:runtime:sync-remote": "node scripts/ensure-demucs-runtime.mjs --runtime-root vendor/demucs-release --prefer-remote-assets --sync-remote-assets --strict",
    "demucs:runtime:package": "node scripts/package-demucs-runtime-assets.mjs",
    "demucs:runtime:package:win": "node scripts/package-demucs-runtime-assets.mjs --platform win32-x64 --output-root dist/demucs-runtime-assets-win32-x64",
    "demucs:runtime:package:mac-arm64": "node scripts/package-demucs-runtime-assets.mjs --platform darwin-arm64 --output-root dist/demucs-runtime-assets-darwin-arm64",
    "demucs:runtime:package:mac-x64": "node scripts/package-demucs-runtime-assets.mjs --platform darwin-x64 --output-root dist/demucs-runtime-assets-darwin-x64",
    "demucs:runtime:merge": "node scripts/merge-demucs-runtime-manifests.mjs",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "dependencies": {
    "@ainsej/rubberband-wasm": "4.0.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "dompurify": "^3.4.13",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.3.5",
    "hotkeys-js": "^4.0.4",
    "iconv-lite": "^0.7.2",
    "marked": "^18.0.9",
    "mitt": "^3.0.1",
    "ml-matrix": "^6.13.0",
    "music-metadata": "^11.14.0",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-vue": "^0.5.10",
    "pinia": "^3.0.4",
    "rust_package": "./rust_package",
    "undici": "^8.10.0",
    "uuid": "^14.0.0",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.8.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "sass": "^1.99.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "better-sqlite3-multiple-ciphers",
      "electron",
      "esbuild",
      "vue-demi"
    ],
    "overrides": {
      "@electron/rebuild>node-abi": "^4.33.0"
    },
    "packageExtensions": {
      "cliui@8": {
        "dependencies": {
          "ansi-styles": "4.3.0"
        }
      }
    }
  }
}
